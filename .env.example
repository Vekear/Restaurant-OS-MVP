# =============================================================================
# 餐厅点餐系统 MVP — 环境变量样例
#
# 用法：
#   cp .env.example .env        # .env 已被 .gitignore 忽略，禁止提交
#
# 双场景说明：
#   - Docker Compose：compose 自动读取根目录 .env 做变量替换；backend 容器内的
#     DB_HOST/REDIS_HOST 由 docker-compose.yml 强制覆盖为 mysql/redis，
#     PAYMENT_CALLBACK_BASE_URL 覆盖为 http://backend:8080，STORAGE_LOCAL_DIR 覆盖为 /app/storage
#   - 本机开发：scripts/dev-local.ps1 优先读取根目录 .env（缺省回退本文件），
#     并把键值注入后端进程环境；同时把 STORAGE_LOCAL_DIR 覆盖为
#     <repo>/.runtime/storage/files（绝对路径）。DB_HOST/REDIS_HOST 保持 127.0.0.1、
#     DB_PASSWORD 与本机 MySQL 一致（123456）。
#
# 安全：JWT_SECRET / TABLE_QR_SECRET / MYSQL_ROOT_PASSWORD 生产必须替换为随机强值；
#       OSS AccessKeySecret、微信 AppSecret 永不写入仓库。
# =============================================================================

# ---------- 通用 ----------
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO

# ---------- MySQL（数据层）----------
# 容器内固定使用 mysql:3306；宿主端口默认 13306，避让本机已占用的 3306
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=restaurant_mvp
MYSQL_HOST_PORT=13306
# 本机后端直连参数（Compose 中会被覆盖为容器服务名）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=restaurant_mvp
DB_USERNAME=root
DB_PASSWORD=123456

# ---------- Redis（数据层）----------
# 容器内固定使用 redis:6379；宿主端口默认 16379，避让本机已占用的 6379
REDIS_HOST_PORT=16379
REDIS_PASSWORD=
REDIS_DATABASE=0
# 本机后端直连参数（Compose 中会被覆盖为容器服务名）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------- 鉴权（JWT HS256）----------
# 至少 32 字节；示例值仅限本地演示，生产务必替换
JWT_SECRET=dev-local-only-jwt-secret-0123456789abcdef0123456789abcdef
JWT_EXPIRES_IN_SECONDS=7200

# ---------- 桌台二维码 HMAC 签名 ----------
TABLE_QR_SECRET=dev-local-only-table-qr-secret-please-change-me
# 二维码内容形如 {TABLE_QR_BASE_URL}?p=<tableId>&s=<signature>
TABLE_QR_BASE_URL=http://127.0.0.1/t

# ---------- 文件存储（local | oss）----------
# 留空 OSS 配置时，后端必须自动降级 local 并打印告警（brief §4.6）
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage
STORAGE_LOCAL_URL_PREFIX=/files
STORAGE_MAX_SIZE_MB=5
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_DIR=restaurant/
OSS_SIGN_EXPIRE_SECONDS=600

# ---------- 微信小程序登录（无凭证时 mock）----------
WECHAT_MOCK=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---------- 模拟支付 / 订单超时 ----------
# 页面展示真实应付金额，实际模拟扣款 0.01 元（brief §4.3）
PAYMENT_MOCK_CHARGE_AMOUNT=0.01
PAYMENT_CALLBACK_BASE_URL=http://127.0.0.1:8080
# 未支付订单超时自动取消（Spring Task，分钟）
ORDER_PAYMENT_TIMEOUT_MINUTES=15
# 桌台会话空闲清理（分钟）
TABLE_SESSION_IDLE_MINUTES=120

# ---------- 跨域 / JVM ----------
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
JAVA_OPTS=-Xms256m -Xmx512m

# ---------- 宿主端口映射（Compose）----------
BACKEND_HOST_PORT=8080
WEB_HOST_PORT=80
