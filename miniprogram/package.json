{
  "name": "restaurant-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "餐厅点餐系统 - 堂食扫码点餐微信小程序（UniApp + Vue3 + JavaScript）",
  "scripts": {
    "dev:h5": "uni --port 5174",
    "dev:h5:mock": "uni --mode mock --port 5174",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:h5:mock": "uni build --mode mock",
    "build:mp-weixin": "uni build -p mp-weixin",
    "dev:mp-weixin:mock": "uni -p mp-weixin --mode mock",
    "build:mp-weixin:mock": "uni build -p mp-weixin --mode mock"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030320261023001",
    "@dcloudio/uni-components": "3.0.0-5030320261023001",
    "@dcloudio/uni-h5": "3.0.0-5030320261023001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030320261023001",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5030320261023001",
    "@dcloudio/uni-stacktracey": "3.0.0-5030320261023001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030320261023001",
    "sass": "1.78.0",
    "vite": "5.2.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
